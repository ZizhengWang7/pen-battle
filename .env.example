# Node 22.13+; npm run build, then npm run server
HOST=0.0.0.0
PORT=3001
# Exact browser origins, comma separated (include your LAN IP when testing devices).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
MAX_ACTIVE_ROOMS=25
MAX_CONNECTIONS=120
ROOM_TTL_MS=600000
RECONNECT_GRACE_MS=60000
# Leave empty for same-origin production or Vite's /socket.io proxy.
VITE_SERVER_URL=

# On Render: NODE_ENV=production; exact origin is read from RENDER_EXTERNAL_URL.
